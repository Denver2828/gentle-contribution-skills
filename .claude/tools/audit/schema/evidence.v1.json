{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gentle-aporte/audit/evidence.v1.json",
  "title": "Evidence record",
  "description": "What was verified, and how it came out. Exists for any state, including a failing one. It never authorises anything by itself, which is why `authorises` is a constant false rather than a field anyone can set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceVersion",
    "evidenceId",
    "gate",
    "gateStatus",
    "candidate",
    "binding",
    "verifications",
    "summary",
    "authorises"
  ],
  "properties": {
    "evidenceVersion": {
      "const": "1.0.0"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gate": {
      "type": "string",
      "minLength": 1
    },
    "gateStatus": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_RUN"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "candidateId",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN",
            "NOT_RUN"
          ]
        },
        "candidateId": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotHash",
        "snapshotHashAfter",
        "stable",
        "policyHash",
        "toolVersion",
        "decisionId"
      ],
      "properties": {
        "snapshotHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshotHashAfter": {
          "type": [
            "string",
            "null"
          ]
        },
        "stable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "policyHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "toolVersion": {
          "type": "string",
          "minLength": 1
        },
        "decisionId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "verifications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "failed",
        "inconclusive",
        "skipped"
      ],
      "description": "Every selected check lands in exactly one bucket. A check absent from all four would be a verification nobody can account for.",
      "properties": {
        "passed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "required",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "required",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "inconclusive": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "required",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "required",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "fail",
        "unknown",
        "notRun"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "notRun": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "authorises": {
      "const": false,
      "description": "Always false. Evidence records what happened; authorising is a separate act with its own preconditions."
    }
  }
}
