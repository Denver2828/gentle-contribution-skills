{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coverage-receipt.v1.json",
  "type": "object",
  "required": ["schemaVersion", "source", "sourceVersion", "scope", "query", "interval", "pages", "returnedCount", "reviewedCount", "authoritativeTotal", "termination", "exclusions", "retrieval"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "coverage-receipt/v1" },
    "source": { "type": "string", "minLength": 1 },
    "sourceVersion": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "query": { "type": "string", "minLength": 1 },
    "interval": {
      "type": ["object", "null"],
      "required": ["since", "until"],
      "additionalProperties": false,
      "properties": {
        "since": { "type": "string", "minLength": 1 },
        "until": { "type": "string", "minLength": 1 }
      }
    },
    "pages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["cursor", "nextCursor", "count"], "additionalProperties": false,
        "properties": {
          "cursor": { "type": ["string", "null"] },
          "nextCursor": { "type": ["string", "null"] },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "returnedCount": { "type": "integer", "minimum": 0 },
    "reviewedCount": { "type": "integer", "minimum": 0 },
    "authoritativeTotal": { "type": ["integer", "null"], "minimum": 0 },
    "termination": { "enum": ["cursor-exhausted", "authoritative-total", "finite-listing", "unknown"] },
    "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "retrieval": { "enum": ["stable-id", "not-applicable", "unavailable"] }
  }
}
