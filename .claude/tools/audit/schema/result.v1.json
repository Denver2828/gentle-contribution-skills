{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gentle-aporte/audit/result.v1.json",
  "title": "Deterministic audit result",
  "description": "Machine-readable outcome of one gate run. This document is the authority; every human summary is derived from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "runId",
    "gate",
    "status",
    "startedAt",
    "finishedAt",
    "repository",
    "policy",
    "binding",
    "summary",
    "checks",
    "errors"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "toolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "runId": { "type": "string", "minLength": 1 },
    "gate": { "type": "string", "minLength": 1 },
    "status": { "$ref": "#/$defs/status" },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "finishedAt": { "$ref": "#/$defs/timestamp" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "branch", "head", "dirty"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "branch": { "type": ["string", "null"] },
        "head": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotHash", "snapshotHashAfter", "stable", "policyHash", "toolVersion", "decisionId"],
      "description": "What this decision is bound to. A result that does not name the state, the policy and the tool version it came from cannot authorise a later action, because there is nothing to compare the later state against.",
      "properties": {
        "snapshotHash": { "type": ["string", "null"], "description": "Hash of the single snapshot every check consumed." },
        "snapshotHashAfter": { "type": ["string", "null"], "description": "Hash of the reading taken after the checks finished." },
        "stable": {
          "type": ["boolean", "null"],
          "description": "True when the two readings match. False forces the gate to UNKNOWN whatever the checks concluded. Null when there was no repository to read, as in a synthetic gate."
        },
        "policyHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "toolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "decisionId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "unknown", "notRun"],
      "properties": {
        "pass": { "$ref": "#/$defs/count" },
        "fail": { "$ref": "#/$defs/count" },
        "unknown": { "$ref": "#/$defs/count" },
        "notRun": { "$ref": "#/$defs/count" }
      }
    },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
    "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
  },
  "$defs": {
    "status": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_RUN"] },
    "count": { "type": "integer", "minimum": 0 },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "required", "durationMs", "reason", "evidence", "remediation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9]+(-[a-z0-9]+)*)+$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "required": { "type": "boolean" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Why this check reached this status. Mandatory for every status, including NOT_RUN, where it carries the motive."
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "remediation": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Required and non-empty when a required check blocks with FAIL, UNKNOWN or NOT_RUN; nullable for PASS and optional checks."
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "observed", "hash"],
      "properties": {
        "type": { "type": "string", "enum": ["git", "github", "file", "process", "computed"] },
        "source": { "type": "string", "minLength": 1 },
        "observed": { "type": "object" },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "checkId"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "checkId": { "type": ["string", "null"] }
      }
    }
  }
}
